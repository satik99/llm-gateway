# Copy to .env and fill in. Never commit .env.

# --- Providers ---
OPENAI_API_KEY=sk-...your-key...
OLLAMA_MODEL=llama3.2                 # leave empty to disable the Ollama fallback
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Infrastructure ---
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://gateway:gateway@localhost:5433/gateway

# --- Keys and admin ---
# name:key:rpm[:tpm[:monthly_budget_usd]]  (comma-separated). More keys can be created via /admin/keys.
GATEWAY_KEYS=team-search:gw-search-123:60:20000:5.00,team-support:gw-support-456:30:10000:2.00
ADMIN_KEY=change-me-to-something-long

# --- Cache ---
CACHE_TTL_S=3600                      # 0 disables caching

# --- Semantic cache (leave EMBED_PROVIDER empty to disable) ---
EMBED_PROVIDER=ollama                 # ollama | openai
EMBED_MODEL=bge-m3
SEMANTIC_THRESHOLD=0.72

# --- Optional hardening / observability ---
# MAX_BODY_BYTES=1048576
# MAX_CONCURRENT_PER_KEY=0
# METRICS_TOKEN=
# ACCESS_LOG=true
