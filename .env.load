# Load-test config: mock upstreams, separate Redis db and Postgres database. Used by load/run_gateway.sh
OPENAI_API_KEY=mock
OPENAI_BASE_URL=http://localhost:9000/v1
OLLAMA_BASE_URL=http://localhost:9001/v1
OLLAMA_MODEL=mock
REDIS_URL=redis://localhost:6379/1
DATABASE_URL=postgresql://gateway:gateway@localhost:5433/gateway_load
ADMIN_KEY=load-admin
GATEWAY_KEYS=load:gw-load-key:100000
CACHE_TTL_S=3600
EMBED_PROVIDER=
ACCESS_LOG=false
